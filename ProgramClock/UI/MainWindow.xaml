<Window x:Class="ProgramClock.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ProgramClock.UI"
        xmlns:ctrl="clr-namespace:ProgramClock.UI.Controls"
        xmlns:charts="clr-namespace:ProgramClock.UI.Charts"
        Title="ProgramClock"
        Icon="/app.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="Manual"
        PreviewKeyDown="OnWindowKeyDown">
    <Window.Resources>
        <local:RefreshArcConverter x:Key="RefreshArc" />
        <ContextMenu x:Key="RowContextMenu" x:Shared="False">
            <MenuItem Header="Reset data (current range)" Click="OnResetSelection" />
            <MenuItem Header="Delete" Click="OnDeleteSelection" />
            <MenuItem Header="Block" Click="OnBlockSelection" />
        </ContextMenu>
        <ContextMenu x:Key="CategoryAppContextMenu" x:Shared="False">
            <MenuItem Header="Delete" Click="OnDeleteManagedApp" />
        </ContextMenu>
        <ContextMenu x:Key="SiteContextMenu" x:Shared="False">
            <MenuItem Header="Delete" Click="OnDeleteSelection" />
            <MenuItem Header="Block" Click="OnBlockSelection" />
        </ContextMenu>

        <!-- Refresh-countdown ring in the Focused/Running headers. The sorted header paints its
             background red, so the red arc would vanish on it: flip the whole ring to the theme
             foreground colour whenever this column is the sorted one. -->
        <Style x:Key="WheelTrack" TargetType="Ellipse">
            <Setter Property="Stroke" Value="{DynamicResource BorderBrush}" />
            <Setter Property="StrokeThickness" Value="2.5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SortDirection, RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}}" Value="Ascending">
                    <Setter Property="Stroke" Value="{DynamicResource ForegroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SortDirection, RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}}" Value="Descending">
                    <Setter Property="Stroke" Value="{DynamicResource ForegroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WheelArc" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
            <Setter Property="StrokeThickness" Value="2.5" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SortDirection, RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}}" Value="Ascending">
                    <Setter Property="Stroke" Value="{DynamicResource ForegroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SortDirection, RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}}" Value="Descending">
                    <Setter Property="Stroke" Value="{DynamicResource ForegroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="12">

        <!-- ===== Dashboard view ===== -->
        <DockPanel Visibility="{Binding DashboardVisibility}">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Wraps so the totals and status pills flow onto extra lines instead of clipping when
                     the window is narrow. Each label+value stays together as one wrap unit. -->
                <WrapPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <TextBlock Text="{Binding FocusLabel}" FontWeight="Bold" />
                        <TextBlock Text="{Binding TotalFocus}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <TextBlock Text="{Binding RunLabel}" FontWeight="Bold" />
                        <TextBlock Text="{Binding TotalRun}" />
                    </StackPanel>

                    <Border CornerRadius="10" Padding="10,2" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource ActiveBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUserIdle}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding IdleStatusText}" Foreground="White"
                                   FontWeight="SemiBold" FontSize="11" />
                    </Border>

                    <Border CornerRadius="10" Padding="10,2" Margin="8,0,0,0" VerticalAlignment="Center"
                            ToolTip="{Binding EfficiencyTooltip}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EfficiencyLevel}" Value="High">
                                        <Setter Property="Background" Value="{DynamicResource ActiveBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EfficiencyLevel}" Value="Mid">
                                        <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EfficiencyLevel}" Value="Low">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding EfficiencyText}" Foreground="White"
                                   FontWeight="SemiBold" FontSize="11" />
                    </Border>
                </WrapPanel>

                <!-- Row 0 (right): action buttons. All use the subtle style except Settings, which is
                     the single accent/red primary button. -->
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Refresh" Style="{StaticResource SubtleButton}"
                            Visibility="{Binding ManualRefreshVisibility}"
                            Click="OnManualRefresh" Margin="0,0,8,0" />
                    <Button Content="Categories" Style="{StaticResource SubtleButton}"
                            Click="OnOpenCategories" Margin="0,0,8,0" />
                    <Button Content="Settings" Click="OnOpenSettings" />
                </StackPanel>

                <!-- Row 1: data controls (range + view dropdowns and the chart metric toggle). The
                     metric button is hidden for the Table view, which already shows both columns.
                     A WrapPanel so the controls flow onto another line instead of clipping when narrow;
                     each label+control stays grouped as one wrap unit. -->
                <WrapPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                           VerticalAlignment="Center" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,4">
                        <TextBlock Text="Range:" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding Ranges}"
                                  SelectedItem="{Binding SelectedRange}"
                                  Width="110" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,4">
                        <TextBlock Text="View:" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding ViewModes}"
                                  SelectedItem="{Binding SelectedViewMode}"
                                  Width="90" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Content="{Binding MetricLabel}" Style="{StaticResource SubtleButton}"
                            Visibility="{Binding MetricToggleVisibility}"
                            Click="OnToggleMetric" Width="90" Margin="0,0,16,4"
                            ToolTip="Switch charts between focused and running time" />
                    <Button Content="Clear range data" Style="{StaticResource SubtleButton}"
                            Click="OnClearRange" Margin="0,0,16,4"
                            ToolTip="Delete all tracked time for the selected range" />
                </WrapPanel>
            </Grid>

            <!-- Dashboard content: the table plus the chart views overlaid, one visible at a time per
                 the View dropdown. The DataGrid stays a permanent (collapsed) child so its selection,
                 sort, drag handlers and row details survive view switches; the charts only draw while
                 visible (see ChartHost). -->
            <Grid>
            <DataGrid x:Name="DashboardGrid"
                      Visibility="{Binding TableVisibility}"
                      ItemsSource="{Binding Rows}"
                      ContextMenuOpening="OnRowContextMenuOpening"
                      Sorting="OnGridSorting"
                      SelectionChanged="OnGridSelectionChanged"
                      PreviewMouseLeftButtonDown="OnGridMouseDown"
                      PreviewMouseMove="OnGridMouseMove"
                      PreviewMouseLeftButtonUp="OnGridMouseUp"
                      LostMouseCapture="OnGridLostMouseCapture"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      EnableRowVirtualization="False"
                      VirtualizingPanel.IsVirtualizing="False"
                      RowDetailsVisibilityMode="Visible">
                <DataGrid.Resources>
                    <local:BindingProxy x:Key="proxy" Data="{Binding}" />
                </DataGrid.Resources>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="ContextMenu" Value="{StaticResource RowContextMenu}" />
                        <!-- Two-way bound so selecting a browser row also selects all of its website
                             sub-rows (see UsageRowVm.IsRowSelected), and the unified delete/block can
                             treat apps and sites as one selection. -->
                        <Setter Property="IsSelected" Value="{Binding IsRowSelected, Mode=TwoWay}" />
                    </Style>
                </DataGrid.RowStyle>
                <!-- Browser rows expand into a per-website focused-time breakdown. The list is always
                     present but collapses to nothing unless the row is expanded and has websites
                     (SitesDetailsVisibility), so opening/closing is driven by the disclosure toggle
                     and is independent of row selection. Columns line up with the main grid; values
                     that match the parent browser are dashed out instead of repeating. -->
                <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                        <Border Visibility="{Binding SitesDetailsVisibility}"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                            <!-- A ListBox (not an ItemsControl) so websites get click / Ctrl-click /
                                 Shift-click / drag multi-selection like the main grid. The parent
                                 grid's mouse handlers leave RowDetails clicks to WPF (see Classify),
                                 so this list owns its own selection via its own drag handlers. -->
                            <ListBox ItemsSource="{Binding Sites}"
                                     SelectionMode="Extended"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     ContextMenu="{StaticResource SiteContextMenu}"
                                     ContextMenuOpening="OnSiteContextMenuOpening"
                                     PreviewMouseLeftButtonDown="OnSiteMouseDown"
                                     PreviewMouseMove="OnSiteMouseMove"
                                     PreviewMouseLeftButtonUp="OnSiteMouseUp"
                                     LostMouseCapture="OnSiteLostMouseCapture"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="Transparent">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background"
                                                                    Value="{DynamicResource AccentBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Column widths mirror the main grid (18 / * / 160 / 140 /
                                             100 / 120 / 120) so websites line up under their columns. -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="1" Text="{Binding Host}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="8,4" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="--" Margin="8,4"
                                                       Foreground="{DynamicResource SubtleBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="--" Margin="8,4"
                                                       Foreground="{DynamicResource SubtleBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="--" Margin="8,4"
                                                       Foreground="{DynamicResource SubtleBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="5" Text="{Binding FocusTime}"
                                                       Margin="8,4" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="6" Text="--" Margin="8,4"
                                                       Foreground="{DynamicResource SubtleBrush}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>
                <DataGrid.Columns>
                    <!-- Disclosure toggle: shown only on browser rows that have websites. Clicking it
                         opens/closes the site list (IsExpanded) independently of row selection; the
                         grid's mouse handlers leave it to WPF by name (see Classify). -->
                    <DataGridTemplateColumn Width="18">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ToggleButton x:Name="DisclosureToggle"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                              Visibility="{Binding SitesVisibility}"
                                              Background="Transparent" BorderThickness="0"
                                              Cursor="Hand" Focusable="False"
                                              ToolTip="Show or hide this browser's websites">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent">
                                                <TextBlock x:Name="Glyph" Text="›" FontWeight="Bold"
                                                           FontSize="14"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource SubtleBrush}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Glyph" Property="Text" Value="⌄" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Application" Binding="{Binding DisplayName}" Width="*" />
                    <DataGridTextColumn Header="Executable" Binding="{Binding ExeName}" Width="160" />
                    <DataGridTemplateColumn Header="Category" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox Margin="2,1"
                                          ItemsSource="{Binding Data.CategoryChoices, Source={StaticResource proxy}}"
                                          SelectedValuePath="Key" DisplayMemberPath="Name"
                                          SelectedValue="{Binding SelectedCategoryKey, Mode=OneWay}"
                                          SelectionChanged="OnRowCategoryChanged"
                                          DropDownOpened="OnRowComboOpened" DropDownClosed="OnRowComboClosed" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Tag" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox Margin="2,1"
                                          ItemsSource="{Binding Data.TagChoices, Source={StaticResource proxy}}"
                                          SelectedValuePath="Tag" DisplayMemberPath="Name"
                                          SelectedValue="{Binding SelectedTag, Mode=OneWay}"
                                          SelectionChanged="OnRowTagChanged"
                                          DropDownOpened="OnRowComboOpened" DropDownClosed="OnRowComboClosed" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn x:Name="FocusedColumn" Binding="{Binding FocusTime}" Width="120"
                                        SortMemberPath="FocusMs">
                        <DataGridTextColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Focused" VerticalAlignment="Center" />
                                <Canvas Width="16" Height="16" Margin="6,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding Data.FocusWheelVisibility, Source={StaticResource proxy}}"
                                        ToolTip="Focused-time refresh countdown">
                                    <Ellipse Width="14" Height="14" Canvas.Left="1" Canvas.Top="1"
                                             Style="{StaticResource WheelTrack}" />
                                    <Path Canvas.Left="1" Canvas.Top="1" Style="{StaticResource WheelArc}"
                                          Data="{Binding Data.FocusRefreshFraction, Source={StaticResource proxy},
                                                 Converter={StaticResource RefreshArc}, ConverterParameter=7}" />
                                </Canvas>
                            </StackPanel>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding RunTime}" Width="120"
                                        SortMemberPath="RunMs">
                        <DataGridTextColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Running" VerticalAlignment="Center" />
                                <Canvas Width="16" Height="16" Margin="6,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding Data.RunWheelVisibility, Source={StaticResource proxy}}"
                                        ToolTip="Running-time refresh countdown">
                                    <Ellipse Width="14" Height="14" Canvas.Left="1" Canvas.Top="1"
                                             Style="{StaticResource WheelTrack}" />
                                    <Path Canvas.Left="1" Canvas.Top="1" Style="{StaticResource WheelArc}"
                                          Data="{Binding Data.RunRefreshFraction, Source={StaticResource proxy},
                                                 Converter={StaticResource RefreshArc}, ConverterParameter=7}" />
                                </Canvas>
                            </StackPanel>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

                <charts:BarChartView   Visibility="{Binding BarVisibility}" />
                <charts:DonutChartView Visibility="{Binding DonutVisibility}" />
                <charts:TrendChartView Visibility="{Binding TrendVisibility}" />

                <!-- Minimal view: just the two headline figures, large, for an at-a-glance read.
                     The Viewbox scales the text DOWN when the window is too small to fit it at full
                     size, but never enlarges it beyond its natural 72px (StretchDirection=DownOnly). -->
                <Grid Visibility="{Binding MinimalVisibility}">
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="16">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,0,24" HorizontalAlignment="Center">
                            <TextBlock Text="Focused" HorizontalAlignment="Center" FontSize="18"
                                       Foreground="{DynamicResource SubtleBrush}" />
                            <TextBlock Text="{Binding MinimalFocused}" HorizontalAlignment="Center"
                                       FontSize="72" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Unfocused" HorizontalAlignment="Center" FontSize="18"
                                       Foreground="{DynamicResource SubtleBrush}" />
                            <TextBlock Text="{Binding MinimalUnfocused}" HorizontalAlignment="Center"
                                       FontSize="72" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}" />
                        </StackPanel>
                    </StackPanel>
                    </Viewbox>
                </Grid>
            </Grid>
        </DockPanel>

        <!-- ===== Settings view ===== -->
        <Grid Visibility="{Binding SettingsVisibility}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="Settings" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TabControl Grid.Row="1">

                <!-- ===== General ===== -->
                <TabItem Header="General">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <CheckBox x:Name="AutoStartCheck" Content="Start ProgramClock with Windows"
                                      Margin="0,0,0,16" />

                            <TextBlock Text="Accent colour" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="AccentSwatchButton" Style="{StaticResource Swatch}"
                                        Width="120" Height="28" Background="{DynamicResource AccentBrush}"
                                        Click="OnOpenAccentPicker" ToolTip="Click to choose the accent colour" />
                                <Button Content="Reset to red" Click="OnResetAccent"
                                        Style="{StaticResource SubtleButton}" Padding="10,4" Margin="8,0,0,0"
                                        VerticalAlignment="Center" />
                                <Popup x:Name="AccentPopup" StaysOpen="False" Placement="Bottom"
                                       PlacementTarget="{Binding ElementName=AccentSwatchButton}"
                                       AllowsTransparency="True">
                                    <ctrl:ColorPicker x:Name="AccentPicker"
                                                      SelectedColorChanged="OnAccentPickerChanged"
                                                      Margin="0,4,0,0" />
                                </Popup>
                            </StackPanel>
                            <TextBlock Text="The highlight colour used for buttons, selected rows, the refresh rings and other accents. Red is the default; click the swatch to pick a colour or enter a hex value. Changes apply instantly."
                                       Foreground="{DynamicResource SubtleBrush}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,6,0,0" />

                            <TextBlock Text="Main colour" FontWeight="SemiBold" Margin="0,20,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="MainSwatchButton" Style="{StaticResource Swatch}"
                                        Width="120" Height="28" Background="{DynamicResource WindowBackgroundBrush}"
                                        Click="OnOpenMainPicker" ToolTip="Click to choose the main colour" />
                                <Button Content="Use system theme" Click="OnResetMainColor"
                                        Style="{StaticResource SubtleButton}" Padding="10,4" Margin="8,0,0,0"
                                        VerticalAlignment="Center" />
                                <Popup x:Name="MainPopup" StaysOpen="False" Placement="Bottom"
                                       PlacementTarget="{Binding ElementName=MainSwatchButton}"
                                       AllowsTransparency="True">
                                    <ctrl:ColorPicker x:Name="MainPicker"
                                                      SelectedColorChanged="OnMainPickerChanged"
                                                      Margin="0,4,0,0" />
                                </Popup>
                            </StackPanel>
                            <TextBlock Text="The app background colour. Defaults to your Windows light/dark theme; click the swatch to pick a colour to override it (text, surfaces and borders adjust to match). Changes apply instantly."
                                       Foreground="{DynamicResource SubtleBrush}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,6,0,0" />

                            <TextBlock Text="Help" FontWeight="SemiBold" Margin="0,20,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Show introduction" Style="{StaticResource SubtleButton}"
                                        Padding="10,4" Click="OnShowIntroduction" />
                                <Button Content="Show patch notes" Style="{StaticResource SubtleButton}"
                                        Padding="10,4" Margin="8,0,0,0" Click="OnShowPatchNotes" />
                            </StackPanel>
                            <TextBlock Text="Re-open the welcome introduction or the latest release's patch notes."
                                       Foreground="{DynamicResource SubtleBrush}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,6,0,0" />

                            <TextBlock Text="Minimum window size" FontWeight="SemiBold" Margin="0,20,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Width"
                                           VerticalAlignment="Center" Margin="0,2" />
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="MinWidthBox" Width="80"
                                         Margin="0,2" HorizontalAlignment="Left" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Height"
                                           VerticalAlignment="Center" Margin="0,2" />
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="MinHeightBox" Width="80"
                                         Margin="0,2" HorizontalAlignment="Left" />
                            </Grid>
                            <TextBlock Text="The smallest the window can be resized, in pixels. Use 0 for no limit, so you can resize the window freely. The defaults keep the whole top bar visible."
                                       Foreground="{DynamicResource SubtleBrush}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Timing ===== -->
                <TabItem Header="Timing">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Pause focused-time tracking after this many seconds of no input:"
                                       TextWrapping="Wrap" Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <TextBox x:Name="IdleSecondsBox" Width="80" />
                                <TextBlock Text="seconds" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>

                            <TextBlock Text="Refresh focused time every:" Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <TextBox x:Name="FocusRefreshBox" Width="80" />
                                <TextBlock Text="seconds" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>

                            <TextBlock Text="Refresh running time every:" Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <TextBox x:Name="RunRefreshBox" Width="80" />
                                <TextBlock Text="seconds" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>

                            <TextBlock Text="Day hours" FontWeight="SemiBold" Margin="0,8,0,6" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Day starts"
                                           VerticalAlignment="Center" Margin="0,2" />
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="DayStartBox" Width="80"
                                         Margin="0,2" HorizontalAlignment="Left"
                                         ToolTip="24-hour time, e.g. 08:00" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Day ends"
                                           VerticalAlignment="Center" Margin="0,2" />
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="DayEndBox" Width="80"
                                         Margin="0,2" HorizontalAlignment="Left"
                                         ToolTip="24-hour time, e.g. 22:00" />
                            </Grid>
                            <TextBlock Text="Running time only starts counting once you first use the PC each day, so it isn't logged while you're away overnight. Use 24-hour time (e.g. 08:00)."
                                       Foreground="{DynamicResource SubtleBrush}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,0,0,12" />

                            <CheckBox x:Name="LockStopCheck"
                                      Content="Stop running time when the PC is locked outside these hours"
                                      Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="after being locked for" VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <TextBox x:Name="LockStopMinutesBox" Width="60" />
                                <TextBlock Text="minutes" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="Unlocking and resuming work outside these hours starts it counting again."
                                       Foreground="{DynamicResource SubtleBrush}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,0,0,4" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Visualizers ===== -->
                <TabItem Header="Visualizers">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Charts" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <CheckBox x:Name="GrowOnHoverCheck"
                                      Content="Grow the hovered section in charts"
                                      Margin="0,0,0,4" />
                            <TextBlock Text="When on, the donut section under the pointer grows slightly and pops outward."
                                       Foreground="{DynamicResource SubtleBrush}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,0,0,14" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Show chart tooltip after" VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <TextBox x:Name="TooltipDelayBox" Width="70" />
                                <TextBlock Text="seconds" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="How long to rest the pointer on a chart section before its describing tooltip appears."
                                       Foreground="{DynamicResource SubtleBrush}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,0,0,4" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Shortcuts ===== -->
                <TabItem Header="Shortcuts">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Keyboard shortcuts" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Delete selection"
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="DeleteHotkeyBox" IsReadOnly="True"
                                         Margin="0,2" Cursor="Hand" PreviewKeyDown="OnHotkeyCapture"
                                         ToolTip="Click here, then press a key" />
                                <Button Grid.Row="0" Grid.Column="2" Content="Clear"
                                        Style="{StaticResource SubtleButton}" Padding="6,2"
                                        Margin="8,2,0,2" Click="OnClearDeleteHotkey" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Block selection"
                                           VerticalAlignment="Center" Margin="0,2,0,0" />
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="BlockHotkeyBox" IsReadOnly="True"
                                         Margin="0,2" Cursor="Hand" PreviewKeyDown="OnHotkeyCapture"
                                         ToolTip="Click here, then press a key" />
                                <Button Grid.Row="1" Grid.Column="2" Content="Clear"
                                        Style="{StaticResource SubtleButton}" Padding="6,2"
                                        Margin="8,2,0,2" Click="OnClearBlockHotkey" />
                            </Grid>
                            <TextBlock Text="Click a box and press a key to bind it. The shortcut applies to the current selection (apps and websites) while the dashboard list has focus. Clear a box to unbind it."
                                       Foreground="{DynamicResource SubtleBrush}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,0,0,4" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Tags ===== -->
                <TabItem Header="Tags">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Tags &amp; efficiency" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Tag" Foreground="{DynamicResource SubtleBrush}" FontSize="11" />
                                <TextBlock Grid.Column="1" Text="Display name" Foreground="{DynamicResource SubtleBrush}" FontSize="11" />
                                <TextBlock Grid.Column="2" Text="Weight" Foreground="{DynamicResource SubtleBrush}" FontSize="11" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding TagLabels}" Margin="0,0,0,16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding TagKey}" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" Margin="0,0,8,0"
                                                     Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox Grid.Column="2"
                                                     Text="{Binding Weight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Rename each tag and set how much its focused time counts toward the efficiency score (0 = ignored)."
                                       Foreground="{DynamicResource SubtleBrush}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,0,0,16" />

                            <TextBlock Text="Efficiency ratings" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Display name" Foreground="{DynamicResource SubtleBrush}" FontSize="11" />
                                <TextBlock Grid.Column="1" Text="Min %" Foreground="{DynamicResource SubtleBrush}" FontSize="11" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding RatingLabels}" Margin="0,0,0,6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="80" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Margin="0,0,8,0"
                                                     Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBox Width="56"
                                                         Text="{Binding ThresholdPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="Lowest efficiency % that earns this rating" />
                                                <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,0,0"
                                                           Foreground="{DynamicResource SubtleBrush}" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="Remove" Click="OnDeleteRating"
                                                    Style="{StaticResource SubtleButton}" Padding="6,2"
                                                    HorizontalAlignment="Left" ToolTip="Remove this rating" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Add rating" Click="OnAddRating" HorizontalAlignment="Left"
                                    Style="{StaticResource SubtleButton}" Padding="10,4" Margin="0,0,0,6" />
                            <TextBlock Text="Rename each rating and set the lowest efficiency percentage that earns it. Add or remove ratings for more or less detail. A result stays at the rating below until its score clears the next threshold; thresholds must increase, and the lowest rating is the floor (treated as 0%)."
                                       Foreground="{DynamicResource SubtleBrush}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,0,0,4" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Blocked ===== -->
                <TabItem Header="Blocked">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Blocked apps" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="4" MaxHeight="160" MinHeight="44">
                                <Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding BlockedApps}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                                        <Button Grid.Column="1" Content="Unblock"
                                                                Style="{StaticResource SubtleButton}"
                                                                Padding="6,2" Click="OnUnblockApp" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock Text="No Blocked Apps" Foreground="{DynamicResource SubtleBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding NoBlockedAppsVisibility}" />
                                </Grid>
                            </Border>
                            <TextBlock Text="These apps are not tracked. Unblock to detect them again."
                                       Foreground="{DynamicResource SubtleBrush}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,6,0,0" />

                            <TextBlock Text="Blocked websites" FontWeight="SemiBold" Margin="0,16,0,6" />
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="4" MaxHeight="160" MinHeight="44">
                                <Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding BlockedSites}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                                        <Button Grid.Column="1" Content="Unblock"
                                                                Style="{StaticResource SubtleButton}"
                                                                Padding="6,2" Click="OnUnblockSite" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock Text="No Blocked Websites" Foreground="{DynamicResource SubtleBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding NoBlockedSitesVisibility}" />
                                </Grid>
                            </Border>
                            <TextBlock Text="These websites are not tracked under any browser. Unblock to track them again."
                                       Foreground="{DynamicResource SubtleBrush}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Updates ===== -->
                <TabItem Header="Updates">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <CheckBox x:Name="AutoUpdateCheck"
                                      Content="Automatically check for updates once a day"
                                      Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Content="Check for Updates" Click="OnCheckForUpdates"
                                        IsEnabled="{Binding UpdateControlsEnabled}"
                                        Style="{StaticResource SubtleButton}" Padding="10,4" />
                                <Button Content="Update Now" Click="OnUpdateNow"
                                        IsEnabled="{Binding UpdateControlsEnabled}"
                                        Margin="8,0,0,0" Padding="10,4" />
                            </StackPanel>
                            <TextBlock Text="{Binding UpdateStatusText}" Foreground="{DynamicResource SubtleBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,4" />
                            <StackPanel Visibility="{Binding DownloadVisibility}" Margin="0,0,0,8">
                                <ProgressBar Height="14" Minimum="0" Maximum="100"
                                             Value="{Binding DownloadProgress}"
                                             Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="{Binding DownloadPercentText}" HorizontalAlignment="Right"
                                           FontSize="11" Margin="0,2,0,0"
                                           Foreground="{DynamicResource SubtleBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

            </TabControl>

            <Grid Grid.Row="2" Margin="0,16,0,0">
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"
                           HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Back" Style="{StaticResource SubtleButton}" Width="90"
                            Margin="0,0,8,0" Click="OnBackToDashboard" />
                    <Button Content="Save" Width="90" Click="OnSaveSettings" IsDefault="True" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ===== Categories view ===== -->
        <Grid Visibility="{Binding CategoriesVisibility}">
            <Grid.Resources>
                <local:BindingProxy x:Key="catProxy" Data="{Binding}" />
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Categories" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center" />
                <Button Content="Back" Style="{StaticResource SubtleButton}" Width="90"
                        HorizontalAlignment="Right" Click="OnBackFromCategories" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Manage categories -->
                <DockPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock DockPanel.Dock="Top" Text="Manage categories"
                               FontWeight="SemiBold" Margin="0,0,0,8" />
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox x:Name="NewCategoryBox" Width="190" />
                        <Button Content="Add" Width="70" Margin="8,0,0,0" Click="OnAddCategory" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding ManagedCategories}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              SelectionMode="Single"
                              EnableRowVirtualization="False"
                              VirtualizingPanel.IsVirtualizing="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                            <DataGridTemplateColumn Header="Default tag" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Margin="2"
                                                  ItemsSource="{Binding Data.DefaultTagChoices, Source={StaticResource catProxy}}"
                                                  SelectedValuePath="Key" DisplayMemberPath="Name"
                                                  SelectedValue="{Binding DefaultTagKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Origin" Binding="{Binding Origin}"
                                                Width="60" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="" Width="70" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Delete" Style="{StaticResource SubtleButton}"
                                                Padding="6,2" Click="OnDeleteCategory" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <!-- Assign apps -->
                <DockPanel Grid.Column="1">
                    <TextBlock DockPanel.Dock="Top" Text="Assign apps to categories"
                               FontWeight="SemiBold" Margin="0,0,0,8" />
                    <!-- Row virtualization is disabled deliberately: the Category/Tag cells are
                         ComboBoxes bound TwoWay (UpdateSourceTrigger=PropertyChanged). With the
                         default virtualization+recycling, scrolling recycles a row's container onto
                         another app and the ComboBox pushes a stale/null SelectedValue into the new
                         row before the binding re-reads it — silently overwriting that app's saved
                         category/tag with a default. Not recycling containers prevents that; the
                         known-app list is small, so the cost is negligible. -->
                    <DataGrid ItemsSource="{Binding ManagedApps}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              SelectionMode="Single"
                              EnableRowVirtualization="False"
                              VirtualizingPanel.IsVirtualizing="False">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="ContextMenu" Value="{StaticResource CategoryAppContextMenu}" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Application" Binding="{Binding DisplayName}" Width="*" />
                            <DataGridTextColumn Header="Executable" Binding="{Binding ExeName}" Width="150" />
                            <DataGridTemplateColumn Header="Category" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Margin="2"
                                                  ItemsSource="{Binding Data.CategoryChoices, Source={StaticResource catProxy}}"
                                                  SelectedValuePath="Id" DisplayMemberPath="Name"
                                                  SelectedValue="{Binding CategoryId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Tag" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Margin="2"
                                                  ItemsSource="{Binding Data.TagChoices, Source={StaticResource catProxy}}"
                                                  SelectedValuePath="Tag" DisplayMemberPath="Name"
                                                  SelectedValue="{Binding Tag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Grid>
        </Grid>

    </Grid>
</Window>
