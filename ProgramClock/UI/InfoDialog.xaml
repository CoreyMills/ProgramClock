<Window x:Class="ProgramClock.UI.InfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProgramClock"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height" Width="470"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,4" />
        <TextBlock x:Name="IntroText" Grid.Row="1" Foreground="{DynamicResource SubtleBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,14" />

        <ItemsControl x:Name="Bullets" Grid.Row="2" Margin="0,0,0,18">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="•" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ForegroundBrush}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button x:Name="OkButton" Grid.Row="3" Content="Got it" HorizontalAlignment="Right"
                Width="110" IsDefault="True" IsCancel="True" Click="OnOk" />
    </Grid>
</Window>
