<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="AccentColor">#D61414</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#2A2A2A" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="#F0F0F0" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#9A9A9A" />
    <SolidColorBrush x:Key="BorderBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="AccentBrush" Color="#E53935" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ActiveBrush" Color="#66BB6A" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FB8C00" />

</ResourceDictionary>
